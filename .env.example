# Пароль для входу в адмінку (/admin). Постав власний через Vercel env variables —
# значення нижче лише приклад для локальної розробки, НЕ використовуй його в проді.
ADMIN_PASSWORD=change-me-please

# Vercel KV (Upstash Redis) — з'являються автоматично після підключення
# KV-стору в Vercel Dashboard → Storage. Без них адмінка/публічна сторінка
# працюють на тимчасовому сховищі в пам'яті процесу (лише для локальної
# розробки, дивись src/lib/kv.ts).
KV_REST_API_URL=
KV_REST_API_TOKEN=
